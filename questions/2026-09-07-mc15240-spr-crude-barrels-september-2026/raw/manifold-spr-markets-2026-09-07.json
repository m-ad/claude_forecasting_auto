            "class": "break-anywhere hover:underline hover:decoration-primary-400 hover:decoration-2 active:underline active:decoration-primary-400",
            "target": "_blank"
           }
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "text": "This market resolves based on the values officially reported by EIA - currently at ",
       "type": "text"
      },
      {
       "text": "https://www.eia.gov/petroleum/supply/weekly/",
       "type": "text",
