            "target": "_blank"
           }
          }
         ]
        },
        {
         "text": "March 11th, ",
         "type": "text"
        },
        {
         "text": "https://www.energy.gov/articles/united-states-release-172-million-barrels-oil-strategic-petroleum-reserve)",
         "type": "text",
         "marks": [
          {
           "type": "link",
