{
  "post_id": 43616,
  "question_id": 43613,
  "title": "Will the Save Our Bacon Act be enacted into law before July 2027?",
  "question_type": "binary",
  "status": "open",
  "resolution": null,
  "scheduled_close_time": "2027-04-01T00:00:00Z",
  "cp_reveal_time": "2026-06-14T13:30:00Z",
  "options": null,
  "scaling": {
    "range_min": null,
