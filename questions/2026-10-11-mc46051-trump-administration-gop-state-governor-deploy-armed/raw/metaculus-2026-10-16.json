{
  "post_id": 46051,
  "question_id": 46289,
  "title": "Will the Trump administration or a GOP state governor deploy armed officers or troops to a polling or early voting site in 2026?",
  "question_type": "binary",
  "status": "open",
  "resolution": null,
  "scheduled_close_time": "2026-11-02T13:00:00Z",
  "cp_reveal_time": "2026-10-15T17:00:00Z",
  "options": null,
  "scaling": {
    "range_min": null,
    "range_max": null,
    "nominal_min": null,
